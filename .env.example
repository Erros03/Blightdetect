# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ROBOFLOW_API_KEY: Optional Roboflow API Key for custom tomato/blight YOLO inference
ROBOFLOW_API_KEY=""

# ROBOFLOW_MODEL_ENDPOINT: Roboflow Model URL/Endpoint (e.g. tomato-defect-and-unripe-detect-kdhgn/1 or custom workspace)
ROBOFLOW_MODEL_ENDPOINT="tomato-defect-and-unripe-detect-kdhgn/1"

# Firebase Client Configuration (Optional - falls back seamlessly to robust local storage persistence if unconfigured)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
